# Copy to backend/.env before: docker compose up
#
# Supabase is required for login and aquarium registry (/api/v1/devices).
# Without it, auth endpoints fail; device list falls back to in-memory storage only
# when calling the API without a real JWT (not useful from the SPA).

ESP32_BASE_URL=http://192.168.1.50
# Or from container to host LAN: http://host.docker.internal (mDNS names like fish.local usually do not resolve in Docker)

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>
